PORT=4000
CLIENT_ORIGIN=http://localhost:5173
SESSION_SECRET=replace-with-a-long-random-secret
# local = sqljs file, hosted = postgres via DATABASE_URL
DB_MODE=local
# Optional explicit override: sqljs or postgres
DB_PROVIDER=sqljs
SQLJS_PATH=./data/dev.sqlite
DATABASE_URL=

# Seed defaults (optional)
ADMIN_LOGINS=admin,lead_admin,ops_admin
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=admin123

# EasyVista (optional - if blank, stub ticket IDs are generated)
EASYVISTA_BASE_URL=
EASYVISTA_API_KEY=
