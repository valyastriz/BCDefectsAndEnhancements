PORT=4000
CLIENT_ORIGIN=http://localhost:5173
SESSION_SECRET=replace-with-a-long-random-secret
# Where sessions live: auto (default) uses Postgres when DB_PROVIDER=postgres and
# MemoryStore otherwise. pg forces the Postgres store, memory forces MemoryStore.
# MemoryStore loses every session on restart, so a deploy signs everybody out —
# leave this on auto unless the store itself is misbehaving.
# SESSION_STORE=auto
# local = sqljs file, hosted = postgres via DATABASE_URL
DB_MODE=local
# Optional explicit override: sqljs or postgres
DB_PROVIDER=sqljs
SQLJS_PATH=./data/dev.sqlite
DATABASE_URL=

# Seed defaults (optional)
ADMIN_LOGINS=admin,lead_admin,ops_admin
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=admin123

# ── EasyVista ────────────────────────────────────────────────────────────────
# Master switch. OFF unless explicitly true/1/yes/on. While it is off, sending
# records a placeholder EV-##### ticket id and transmits nothing, however the
# rest of this section is configured. Turn it on only once the endpoint path and
# response shape below are confirmed — the payload builder is finished, but
# those two are still assumptions.
EASYVISTA_ENABLED=false
# How a not-yet-live send is presented. ON unless explicitly false/0/no/off, and
# ignored entirely once EASYVISTA_ENABLED is live. On: the flow is shown exactly
# as it will work once the integration is switched on — press send, get an
# incident number, ticket moves to Submitted — which is what makes it
# demonstrable to stakeholders. Off: every surface says the number is a
# placeholder and nothing was transmitted.
EASYVISTA_DEMO_MODE=true
EASYVISTA_BASE_URL=
EASYVISTA_API_KEY=
# Ticket-create path appended to the base URL. Unverified default.
EASYVISTA_REQUESTS_PATH=/requests
# ── Catalogs: which queue in EasyVista each application's tickets are raised in ──
# A catalog is an identifier INSIDE EasyVista, so the team that runs EasyVista is
# the one with the value — which is why it lives here beside the API key and not
# on a page in the app. Each application needs its own: the outgoing payload's
# field names are repurposed from one specific catalog, so a ticket sent to the
# wrong one is mis-mapped, not just misfiled.
#
# Per application, as "Name:value,Other Name:value" (same shape as
# EASYVISTA_ADMIN_MAILS below). Names match the applications table.
# EASYVISTA_CATALOG_GUIDS=Billing Center:0000-aaaa,Policy Center:1111-bbbb
EASYVISTA_CATALOG_GUIDS=
EASYVISTA_CATALOG_CODES=
# The single-catalog form, kept for the one application named below. Any
# application NOT named here is refused rather than silently inheriting it.
EASYVISTA_DEFAULT_APPLICATION=
EASYVISTA_CATALOG_GUID=
EASYVISTA_CATALOG_CODE=
EASYVISTA_ORIGIN=3
EASYVISTA_SEVERITY_ID=40
# Fallback urgency when a ticket has no Priority Level (3 = Medium). When it has
# one, the leading digit of "1 - Urgent".."4 - Low" is used instead.
EASYVISTA_URGENCY_ID=3
# Requestor/Recipient on the ticket is the admin who pressed send. The users
# table has no email column, so map usernames here: "user:mail,user:mail".
EASYVISTA_ADMIN_MAILS=
# Used for any admin not listed above.
EASYVISTA_FALLBACK_MAIL=

# ── AI semantic ticket search (optional) ─────────────────────────────────────
# The feature turns on once a summary key (Claude or OpenAI) is set; leave both
# blank to keep it disabled (the panel is hidden).
#
# AI_PROVIDER is the master switch — flip it per environment:
#   AI_PROVIDER=openai    -> OpenAI summary + OpenAI embeddings (one key)
#   AI_PROVIDER=anthropic -> Claude summary + LOCAL self-hosted embeddings
#
# Embeddings run one of three ways (Claude has no embeddings API of its own):
#   local  = a small model runs inside the app — no vendor, no key, no per-call
#            cost, text never leaves the server (default unless provider=openai)
#   openai = OpenAI's embeddings API (needs OPENAI_API_KEY)
#   voyage = Voyage AI's embeddings API (needs VOYAGE_API_KEY)
#
# ── DEMO preset (all OpenAI, one key) ──
#   AI_PROVIDER=openai
#   OPENAI_API_KEY=sk-...
#
# ── WORK preset (Claude + self-hosted embeddings, zero third-party vendors) ──
#   AI_PROVIDER=anthropic
#   ANTHROPIC_API_KEY=sk-ant-...
#   (embeddings default to local — no extra key needed)
#
AI_PROVIDER=

# Keys (fill in the ones your AI_PROVIDER needs):
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
VOYAGE_API_KEY=

# Models (defaults are fine; override to pin a specific model):
AI_MODEL=claude-haiku-4-5
OPENAI_SUMMARY_MODEL=gpt-4o-mini
# EMBEDDINGS_MODEL=Xenova/all-MiniLM-L6-v2   # local default; auto-picks per provider

# Advanced overrides (usually leave unset — AI_PROVIDER handles these):
# AI_SUMMARY_PROVIDER=anthropic   # anthropic | openai
# EMBEDDINGS_PROVIDER=local        # local | openai | voyage

# Ranking (newer + higher-match first): final = match + weight * recency
AI_SEARCH_RECENCY_WEIGHT=0.15
AI_SEARCH_RECENCY_HALFLIFE_DAYS=180

# Tuning:
AI_SEARCH_ENABLED=true
AI_SEARCH_PUBLIC_ENABLED=true
AI_SEARCH_TOP_K=20
AI_SEARCH_MAX_QUERY_LENGTH=500
AI_SEARCH_MAX_INLINE_EMBED=25
AI_SEARCH_PUBLIC_RATE_LIMIT=20
AI_SEARCH_PUBLIC_RATE_WINDOW_MS=60000
